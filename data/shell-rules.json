{
  "groups": [
    { "id": "disk", "name": "磁盘操作" },
    { "id": "net", "name": "网络与防火墙" },
    { "id": "service", "name": "系统服务" },
    { "id": "user", "name": "用户管理" },
    { "id": "delete", "name": "文件删除" },
    { "id": "perm", "name": "权限" },
    { "id": "proc", "name": "进程控制" },
    { "id": "git", "name": "Git 操作" },
    { "id": "inject", "name": "命令注入" },
    { "id": "script", "name": "脚本执行" }
  ],
  "rules": [
    { "id": "disk.dd.dev", "group": "disk", "cmd": "dd", "literal": "of=/dev/", "label": "dd 写块设备", "deny": true },
    { "id": "disk.dd", "group": "disk", "cmd": "dd", "label": "dd" },
    { "id": "disk.mkfs", "group": "disk", "cmd": "mkfs", "prefix": true, "label": "mkfs" },
    { "id": "disk.fdisk", "group": "disk", "cmd": "fdisk", "label": "fdisk" },
    { "id": "disk.sfdisk", "group": "disk", "cmd": "sfdisk", "label": "sfdisk" },
    { "id": "disk.parted", "group": "disk", "cmd": "parted", "label": "parted" },
    { "id": "disk.wipefs", "group": "disk", "cmd": "wipefs", "label": "wipefs" },
    { "id": "disk.diskpart", "group": "disk", "cmd": "diskpart", "label": "diskpart" },
    { "id": "disk.hdparm", "group": "disk", "cmd": "hdparm", "label": "hdparm" },
    { "id": "disk.format", "group": "disk", "cmd": "format", "label": "format" },

    { "id": "net.nc", "group": "net", "cmd": "nc", "label": "nc" },
    { "id": "net.ncat", "group": "net", "cmd": "ncat", "label": "ncat" },
    { "id": "net.socat", "group": "net", "cmd": "socat", "label": "socat" },
    { "id": "net.iptables", "group": "net", "cmd": "iptables", "label": "iptables" },
    { "id": "net.ufw", "group": "net", "cmd": "ufw", "label": "ufw" },
    { "id": "net.firewall-cmd", "group": "net", "cmd": "firewall-cmd", "label": "firewall-cmd" },
    { "id": "net.netsh", "group": "net", "cmd": "netsh", "label": "netsh" },

    { "id": "service.systemctl", "group": "service", "cmd": "systemctl", "label": "systemctl" },
    { "id": "service.service", "group": "service", "cmd": "service", "label": "service" },
    { "id": "service.chkconfig", "group": "service", "cmd": "chkconfig", "label": "chkconfig" },
    { "id": "service.crontab", "group": "service", "cmd": "crontab", "label": "crontab" },
    { "id": "service.at", "group": "service", "cmd": "at", "label": "at" },

    { "id": "user.passwd", "group": "user", "cmd": "passwd", "label": "passwd" },
    { "id": "user.usermod", "group": "user", "cmd": "usermod", "label": "usermod" },
    { "id": "user.useradd", "group": "user", "cmd": "useradd", "label": "useradd" },
    { "id": "user.userdel", "group": "user", "cmd": "userdel", "label": "userdel" },

    { "id": "delete.rm.root", "group": "delete", "cmd": "rm", "short": "rR", "long": ["recursive"], "target": "root", "label": "rm -r 根目录", "deny": true },
    { "id": "delete.rm", "group": "delete", "cmd": "rm", "short": "rR", "long": ["recursive"], "label": "rm -r" },
    { "id": "delete.rm.plain", "group": "delete", "cmd": "rm", "label": "rm" },
    { "id": "delete.rmdir", "group": "delete", "cmd": "rmdir", "label": "rmdir" },
    { "id": "delete.shred", "group": "delete", "cmd": "shred", "label": "shred" },
    { "id": "delete.srm", "group": "delete", "cmd": "srm", "label": "srm" },
    { "id": "delete.unlink", "group": "delete", "cmd": "unlink", "label": "unlink" },
    { "id": "delete.truncate", "group": "delete", "cmd": "truncate", "short": "s", "label": "truncate -s" },
    { "id": "delete.del", "group": "delete", "cmd": "del", "label": "del" },
    { "id": "delete.rd", "group": "delete", "cmd": "rd", "short": "s", "label": "rd /s" },
    { "id": "delete.remove-item", "group": "delete", "cmd": "remove-item", "literal": "-recurse", "label": "Remove-Item -Recurse" },
    { "id": "delete.find-delete", "group": "delete", "cmd": "find", "literal": "-delete", "label": "find -delete" },
    { "id": "delete.find-exec-rm", "group": "delete", "cmd": "find", "literal": "-exec rm", "label": "find -exec rm" },

    { "id": "perm.chmod", "group": "perm", "cmd": "chmod", "label": "chmod" },
    { "id": "perm.chmod777", "group": "perm", "cmd": "chmod", "literal": "777", "label": "chmod 777" },
    { "id": "perm.chown", "group": "perm", "cmd": "chown", "label": "chown" },
    { "id": "perm.chgrp", "group": "perm", "cmd": "chgrp", "label": "chgrp" },
    { "id": "perm.setfacl", "group": "perm", "cmd": "setfacl", "label": "setfacl" },
    { "id": "perm.attrib", "group": "perm", "cmd": "attrib", "label": "attrib" },
    { "id": "perm.icacls", "group": "perm", "cmd": "icacls", "label": "icacls" },
    { "id": "perm.takeown", "group": "perm", "cmd": "takeown", "label": "takeown" },

    { "id": "proc.kill", "group": "proc", "cmd": "kill", "label": "kill" },
    { "id": "proc.killall", "group": "proc", "cmd": "killall", "label": "killall" },
    { "id": "proc.pkill", "group": "proc", "cmd": "pkill", "label": "pkill" },
    { "id": "proc.taskkill", "group": "proc", "cmd": "taskkill", "short": "f", "label": "taskkill /f" },
    { "id": "proc.kill9", "group": "proc", "cmd": "kill", "short": "9", "label": "kill -9" },

    { "id": "git.reset-hard", "group": "git", "cmd": "git", "literal": "reset --hard", "label": "git reset --hard" },
    { "id": "git.clean", "group": "git", "cmd": "git", "literals": ["clean -f", "clean -d", "clean -x"], "label": "git clean -f" },
    { "id": "git.push-force", "group": "git", "cmd": "git", "literals": ["push --force", "push -f"], "label": "git push --force" },
    { "id": "git.branch-delete", "group": "git", "cmd": "git", "literal": "branch -D", "label": "git branch -D" },
    { "id": "git.checkout-ddash", "group": "git", "cmd": "git", "literal": "checkout --", "label": "git checkout --" },
    { "id": "git.restore", "group": "git", "cmd": "git", "literal": "restore .", "label": "git restore ." },
    { "id": "git.filter-branch", "group": "git", "cmd": "git", "literal": "filter-branch", "label": "git filter-branch" },
    { "id": "git.update-ref", "group": "git", "cmd": "git", "literal": "update-ref -d", "label": "git update-ref -d" },
    { "id": "git.gc-prune", "group": "git", "cmd": "git", "literal": "--prune=now", "label": "git gc --prune=now" },
    { "id": "git.reflog-expire", "group": "git", "cmd": "git", "literal": "reflog expire", "label": "git reflog expire" },
    { "id": "git.stash-drop", "group": "git", "cmd": "git", "literals": ["stash drop", "stash clear"], "label": "git stash drop" },

    { "id": "inject.pipe-sh", "group": "inject", "scope": "line", "literal": "| sh", "label": "把内容喂给 sh" },
    { "id": "inject.pipe-bash", "group": "inject", "scope": "line", "literal": "| bash", "label": "把内容喂给 bash" },
    { "id": "inject.pipe-zsh", "group": "inject", "scope": "line", "literal": "| zsh", "label": "把内容喂给 zsh" },
    { "id": "inject.pipe-sudo", "group": "inject", "scope": "line", "literal": "| sudo", "label": "把内容喂给 sudo" },
    { "id": "inject.pipe-base64", "group": "inject", "scope": "line", "literal": "base64 -d |", "label": "base64 解码后执行" },
    { "id": "inject.eval", "group": "inject", "scope": "line", "literal": "eval $(", "label": "eval 命令替换" },
    { "id": "inject.bash-c", "group": "inject", "cmd": "bash", "short": "c", "label": "bash -c" },
    { "id": "inject.sh-c", "group": "inject", "cmd": "sh", "short": "c", "label": "sh -c" },
    { "id": "inject.zsh-c", "group": "inject", "cmd": "zsh", "short": "c", "label": "zsh -c" },
    { "id": "inject.find-exec-sh", "group": "inject", "cmd": "find", "literal": "-exec sh", "label": "find -exec sh" },
    { "id": "inject.awk-system", "group": "inject", "cmd": "awk", "literal": "system(", "label": "awk system()" },

    { "id": "script.python-c", "group": "script", "cmd": "python", "short": "c", "label": "python -c" },
    { "id": "script.python3-c", "group": "script", "cmd": "python3", "short": "c", "label": "python3 -c" },
    { "id": "script.node-e", "group": "script", "cmd": "node", "short": "e", "label": "node -e" },
    { "id": "script.perl-e", "group": "script", "cmd": "perl", "short": "e", "label": "perl -e" },
    { "id": "script.ruby-e", "group": "script", "cmd": "ruby", "short": "e", "label": "ruby -e" }
  ]
}
