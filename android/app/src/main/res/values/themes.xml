<resources>
    <!-- 不引 AppCompat / Material Components：整屏都是 Compose，只借一个无 ActionBar 的底子。
         windowBackground 用来盖住冷启动那一帧；浅色/深色各有对应资源（values-night 那一份是深色），
         强制主题时由 MainActivity 在 setContent 之前按用户选择改掉。 -->
    <style name="Theme.NMoi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nmoi_window_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
